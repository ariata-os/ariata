{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Virtues",
  "version": "1.0.28",
  "identifier": "com.virtues.desktop",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://localhost:7117 http://*.virtues:8000 http://*:8000; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://localhost:7117 ws://localhost:7117 http://*.virtues:8000 ws://*.virtues:8000 http://*:8000 ws://*:8000 https://atlas.virtues.com"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["dmg", "app"],
    "externalBin": ["binaries/virtues-collector"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "icons/AppIcon.compiled/Assets.car": "Assets.car",
      "icons/AppIcon.compiled/AppIcon.icns": "AppIcon.icns"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist",
      "signingIdentity": null,
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 195 },
        "applicationFolderPosition": { "x": 480, "y": 195 }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDREQzdBMzVDNDVCN0ZCOEQKUldTTis3ZEZYS1BIVGRJRGk3R2hBMWU3TUZiR0FSQlZHVXdIWjNVYjRvUUt3Y3k3ZE9EM0RkS2wK",
      "endpoints": [
        "https://github.com/virtues-os/virtues/releases/download/mac-latest/latest.json"
      ]
    }
  }
}
